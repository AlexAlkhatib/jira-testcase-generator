# ---------------------------------------------------------------------------
# Jira Test Case Generator — environment template
# Copy to .env (never committed) or export these variables before starting.
# ---------------------------------------------------------------------------

# --- Jira (required) -------------------------------------------------------
# Atlassian Cloud: https://your-domain.atlassian.net  (the /rest/api/3 suffix is optional)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
# Create a fresh token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=replace-with-your-token

# Jira Server / Data Center: use API version 2
JIRA_API_VERSION=3

# Optional: customfield id that stores the acceptance criteria (e.g. customfield_10042)
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Jira HTTP timeout
JIRA_TIMEOUT=15s

# --- Local AI (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=mistral
AI_TEMPERATURE=0.2
AI_NUM_CTX=8192

# --- Application ----------------------------------------------------------
SERVER_PORT=8080
GENERATION_DEFAULT_TEST_CASES=8
GENERATION_MAX_TEST_CASES=20
GENERATION_MAX_STORY_CHARACTERS=8000
